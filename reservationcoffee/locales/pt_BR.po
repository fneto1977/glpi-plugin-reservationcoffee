#: templates/config.html.twig:8
msgid "Coffee Break Reservation Settings"
msgstr "Configurações de Reserva com Coffee Break"

#: templates/config.html.twig:11
msgid "Configure reservable meeting rooms, associate the coffee break form, and map questions for automatic pre-fill."
msgstr "Configure as salas reserváveis, vincule o formulário de coffee break e mapeie as perguntas para preenchimento automático."

#: templates/config.html.twig:22
msgid "Plugin Active and Operational"
msgstr "Plugin Ativo e Operacional"

#: templates/config.html.twig:23
msgid "Meeting room reservations will display the coffee break offer and pre-fill the selected form."
msgstr "As reservas de salas participantes exibirão a oferta de coffee break e preencherão o formulário selecionado."

#: templates/config.html.twig:30
msgid "Configuration Incomplete (Fail-Closed)"
msgstr "Configuração Incompleta (Fail-Closed)"

#: templates/config.html.twig:32
msgid "The plugin is currently dormant until the required settings are completed. Native reservations remain unaffected."
msgstr "O plugin está inativo até que as configurações obrigatórias sejam preenchidas. As reservas nativas não são afetadas."

#: templates/config.html.twig:35
msgid "No meeting rooms selected."
msgstr "Nenhuma sala de reunião selecionada."

#: templates/config.html.twig:38
msgid "No coffee break form selected."
msgstr "Nenhum formulário de coffee break selecionado."

#: templates/config.html.twig:41
msgid "Question \"ID da reserva\" is not mapped (mandatory for security validation)."
msgstr "A pergunta \"ID da reserva\" não está mapeada (obrigatória para validação de segurança)."

#: templates/config.html.twig:55
msgid "Default Coffee Break Form"
msgstr "Formulário Padrão de Coffee Break"

#: templates/config.html.twig:58
msgid "Provision or link the standard coffee break form (\"Solicitação de Coffee Break\") with all 9 questions, conditional visibility, and ticket destination."
msgstr "Provisione ou vincule o formulário padrão (\"Solicitação de Coffee Break\") com as 9 perguntas, visibilidade condicional e destino de chamado."

#: templates/config.html.twig:66
msgid "Provision / Restore Default Form"
msgstr "Provisionar / Restaurar Formulário Padrão"

#: templates/config.html.twig:84
msgid "Reservable Meeting Rooms"
msgstr "Salas de Reunião Reserváveis"

#: templates/config.html.twig:89
msgid "Select the meeting rooms that will offer the coffee break service when reserved."
msgstr "Selecione as salas de reunião que oferecerão o serviço de coffee break quando reservadas."

#: templates/config.html.twig:93
msgid "Rooms with coffee break offer"
msgstr "Salas com oferta de coffee break"

#: templates/config.html.twig:112
msgid "Hold Ctrl (or Cmd on Mac) to select multiple rooms."
msgstr "Segure Ctrl (ou Cmd no Mac) para selecionar múltiplas salas."

#: templates/config.html.twig:125
msgid "Form and Execution Options"
msgstr "Formulário e Opções de Execução"

#: templates/config.html.twig:131
msgid "Coffee Break Form"
msgstr "Formulário de Coffee Break"

#: templates/config.html.twig:139
msgid "Select a form"
msgstr "Selecione um formulário"

#: templates/config.html.twig:150
msgid "Form presented to the user after reserving a participating room."
msgstr "Formulário apresentado ao usuário após reservar uma sala participante."

#: templates/config.html.twig:156
msgid "Offer expiration TTL (seconds)"
msgstr "TTL de expiração da oferta (segundos)"

#: templates/config.html.twig:169
msgid "Allowed range: 5 to 3600 seconds (default: 300 = 5 minutes)."
msgstr "Intervalo permitido: 5 a 3600 segundos (padrão: 300 = 5 minutos)."

#: templates/config.html.twig:182
msgid "Form Question Mapping"
msgstr "Mapeamento de Perguntas do Formulário"

#: templates/config.html.twig:187
msgid "Map the fields of the selected form to the corresponding reservation and user attributes."
msgstr "Mapeie os campos do formulário selecionado para os atributos correspondentes da reserva e do usuário."

#: templates/config.html.twig:194
msgid "Reservation ID (Mandatory)"
msgstr "ID da Reserva (Obrigatório)"

#: templates/config.html.twig:202
msgid "Select a question"
msgstr "Selecione uma pergunta"

#: templates/config.html.twig:213
msgid "Essential for linking the ticket to the reservation and preventing unauthorized submissions."
msgstr "Essencial para vincular o chamado à reserva e impedir submissões não autorizadas."

#: templates/config.html.twig:220
msgid "Requester Name (Optional)"
msgstr "Nome do Solicitante (Opcional)"

#: templates/config.html.twig:228 templates/config.html.twig:251
#: templates/config.html.twig:274 templates/config.html.twig:297
#: templates/config.html.twig:320
msgid "None / Not mapped"
msgstr "Nenhum / Não mapeado"

#: templates/config.html.twig:243
msgid "Reservation Date (Optional)"
msgstr "Data da Reserva (Opcional)"

#: templates/config.html.twig:266
msgid "Start Time (Optional)"
msgstr "Horário de Início (Opcional)"

#: templates/config.html.twig:289
msgid "Room Name (Optional)"
msgstr "Nome da Sala (Opcional)"

#: templates/config.html.twig:312
msgid "Participants Count (Optional)"
msgstr "Quantidade de Participantes (Opcional)"

#: templates/config.html.twig:336
msgid "Save Settings"
msgstr "Salvar Configurações"

#: templates/offer_coffee.html.twig:22
msgid "There is no pending coffee break offer for this reservation."
msgstr "Não há oferta de coffee break pendente para esta reserva."

#: templates/offer_coffee.html.twig:27
msgid "Reservation created successfully"
msgstr "Reserva criada com sucesso"

#: templates/offer_coffee.html.twig:35
msgid "Period"
msgstr "Período"

#: templates/offer_coffee.html.twig:37
msgid "%1$s to %2$s"
msgstr "%1$s a %2$s"

#: templates/offer_coffee.html.twig:40
msgid "Reservation ID"
msgstr "ID da reserva"

#: templates/offer_coffee.html.twig:45
msgid "Would you like to request a coffee break?"
msgstr "Deseja solicitar coffee break?"

#: templates/offer_coffee.html.twig:51
msgid "No, back to the calendar"
msgstr "Não, voltar ao calendário"

#: templates/offer_coffee.html.twig:58
msgid "Request coffee break"
msgstr "Solicitar coffee break"

#: templates/offer_coffee.html.twig:66
msgid "A coffee break cannot be requested because the meeting starts in less than 48 hours."
msgstr "Não é possível solicitar coffee break porque a reunião começa em menos de 48 horas."

#: templates/offer_coffee.html.twig:71
msgid "Your reservation is confirmed, but the coffee break request is unavailable right now. You can try again from the service catalog."
msgstr "Sua reserva está confirmada, mas a solicitação de coffee break está indisponível no momento. Você pode tentar novamente a partir do catálogo de serviços."

#: templates/offer_coffee.html.twig:77
msgid "Back to the calendar"
msgstr "Voltar ao calendário"

#: templates/offer_coffee.html.twig:81
msgid "Service catalog"
msgstr "Catálogo de serviços"
