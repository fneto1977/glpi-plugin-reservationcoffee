# Copy to .env and replace the placeholders. Never commit .env.
E2E_DB_ROOT_PASSWORD=change-me-root
E2E_DB_PASSWORD=change-me-glpi
E2E_HTTP_PORT=8080
E2E_TIMEZONE=America/Sao_Paulo

# Synthetic E2E user passwords (created by tools/seed_e2e.php)
E2E_PASSWORD_SELFSERVICE=change-me-selfservice
E2E_PASSWORD_SELFSERVICE2=change-me-selfservice2
E2E_PASSWORD_TECH=change-me-tech
E2E_PASSWORD_OTHERENTITY=change-me-otherentity
E2E_GLPI_ADMIN_PASSWORD=glpi

# Optional: use an installed browser channel instead of the bundled Chromium (e.g. chrome)
E2E_BROWSER_CHANNEL=
